{
	"compilerOptions": {
		"target": "ES2020",
		"watch": false,
		"sourceMap": true,
		"experimentalDecorators": true,
		"jsx": "react",
		"baseUrl": "./src",
		"outDir": "./out",
		"module": "commonjs",
		"noImplicitAny": false,
		"strictNullChecks": false,
		"noImplicitThis": false,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable",
			"WebWorker",
			"ScriptHost"
		]
	},
	"exclude": [
		"node_modules",
		"out",
		"build",
		"docs",
		"euiruntime"
	]
}